<!--
  ros2_control fragment for the PAROL6 arm. Spliced into parol6's plain
  (non-xacro) URDF just before </robot> by parol6_control.launch.py, rather
  than xacro:include'd -- the upstream URDF is a raw <robot> document, not a
  xacro macro, so string-splicing avoids nested-<robot> ambiguity.

  __BRIDGE_HOST__ / __BRIDGE_PORT__ are substituted by the launch file from
  the bridge_host / bridge_port launch arguments.
-->
<ros2_control name="Parol6System" type="system">
  <hardware>
    <plugin>parol6_hardware_interface/Parol6SystemInterface</plugin>
    <param name="bridge_host">__BRIDGE_HOST__</param>
    <param name="bridge_port">__BRIDGE_PORT__</param>
    <param name="connect_timeout_sec">10.0</param>
  </hardware>
  <joint name="L1">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
  </joint>
  <joint name="L2">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
  </joint>
  <joint name="L3">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
  </joint>
  <joint name="L4">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
  </joint>
  <joint name="L5">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
  </joint>
  <joint name="L6">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
  </joint>
</ros2_control>
